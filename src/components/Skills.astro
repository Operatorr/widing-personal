---
import Section from './Section.astro';
import SectionHead from './SectionHead.astro';
import { resume } from '../lib/resume';
import { DEPTHS } from '../lib/depth';
const { skills } = resume;
---

<Section id="skills" depth={DEPTHS.skills} from={DEPTHS.skills} to={DEPTHS.education}>
  <SectionHead id="skills-h" title="Skills" depth={DEPTHS.skills} />
  <ul class="skills list">
    {skills.map((s) => (
      <li class="skill">
        <div class="skill-top">
          <h3>{s.name}</h3>
          <span class="level" data-level={s.level}>
            <i aria-hidden="true"><b></b><b></b><b></b><b></b></i>
            {s.level}
          </span>
        </div>
        <ul class="chips">
          {s.keywords.map((k) => <li class="chip">{k}</li>)}
        </ul>
      </li>
    ))}
  </ul>
</Section>
