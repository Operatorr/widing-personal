---
import { resume } from '../lib/resume';

const yearNow = new Date().getFullYear();
const updated = new Date(resume.meta.lastModified).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
const host = resume.basics.url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---
<footer class="colophon-wrap">
  <div class="wrap colophon">
    <p>
      <span class="mono">Colophon</span>
      Set in Fraunces, Instrument Sans and IBM Plex Mono. Built with Astro from a single JSON Resume file.
      The light in the header is a small WebGL shader; it stays off when you ask for reduced motion.
    </p>
    <p>
      <span class="mono">Edition</span>
      Last updated {updated}. The print version lives at <a href="/cv">/cv</a>.
    </p>
    <p>
      <span class="mono">Imprint</span>
      © {yearNow} {resume.basics.name} · <a href={resume.basics.url}>{host}</a>
    </p>
  </div>
</footer>
