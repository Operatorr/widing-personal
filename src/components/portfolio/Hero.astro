---
import { Icon } from 'astro-icon/components';
import { resume, yearsOfExperience } from '../../lib/resume';
const linkedin = resume.basics.profiles[0].url;
---
<section class="hero" aria-labelledby="hero-title" id="top">
  <header class="nav shell">
    <a class="wordmark" href="#top" aria-label="Alexander Widing, home">AW</a>
    <span class="nav-caption">Alexander Widing<span class="nav-role"><br />Solutions architect & founding engineer</span></span>
    <nav aria-label="Main navigation">
      <a href="#contributions">Work</a><a href="#experience">Experience</a><a href="#work">Projects</a>
    </nav>
    <a class="nav-contact nav-resume" href="/cv">Résumé <Icon name="solar:arrow-right-up-linear" /></a>
    <a class="nav-contact" href={linkedin} target="_blank" rel="noopener noreferrer">Contact <Icon name="solar:arrow-right-up-linear" /></a>
  </header>
  <div class="hero-heading shell">
    <div>
      <p class="eyebrow">Solutions architect / Founding engineer</p>
      <h1 id="hero-title">Architect.<br />Find solutions.<br />Solve problems.<br /><em>Ship.</em></h1>
    </div>
    <div class="hero-intro">
      <p>A Swedish engineer in Bangkok. I've built company software for {yearsOfExperience()} years, from ERP and accounting systems to custom solutions for clients.</p>
      <span>Lately I build apps for two kinds of users:<br />people, and the AI agents acting for them.</span>
      <p class="hero-eligibility">Bangkok, Thailand<br />Swedish citizen · EU right to work</p>
    </div>
  </div>
  <div class="portrait-stage shell">
    <div class="hero-facts">
      <p class="eyebrow">Experience</p>
      <p class="experience-number">{yearsOfExperience()}<span>+</span></p>
      <p>Years building<br />production software</p>
      <div class="hero-citizenship"><span class="swedish-cross" aria-hidden="true"></span><p>Swedish citizen<br /><strong>EU right to work</strong></p></div>
    </div>
    <div class="hero-surname" aria-hidden="true">WIDING</div>
    <div class="phone-wrap">
      <div class="phone">
        <div class="phone-status" aria-hidden="true"><span>09:41</span><span class="phone-island"></span><Icon name="solar:battery-full-linear" /></div>
        <img src="/images/alexander-ember.webp" width="960" height="1440" alt="AI-styled studio portrait of Alexander Widing, in clear glasses and a black shirt, lit in warm orange" fetchpriority="high" />
        <div class="phone-caption">
          <p>Alexander<br />Widing</p>
          <div class="phone-footer"><span>Based in Bangkok<br />Originally from Sweden</span></div>
        </div>
      </div>
    </div>
    <div class="hero-location">
      <span class="eyebrow">Currently</span>
      <p>Designing and building<br />interfaces for AI agents<br />at DxT.</p>
      <span class="location-dot">Bangkok, Thailand</span>
      <a class="round-link" href="#contributions" aria-label="Explore contribution history"><Icon name="solar:arrow-down-linear" /></a>
    </div>
  </div>
  <div class="hero-bottom shell"><span>Writing software professionally since 2015.</span><span>Scroll down <Icon name="solar:arrow-down-linear" /></span></div>
</section>
