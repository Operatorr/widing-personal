---
import { Icon } from 'astro-icon/components';
import data from '../../data/contributions.json';
import { yearsOfExperience } from '../../lib/resume';
const format = new Intl.NumberFormat('en-US');
const currentYear = new Date(data.generatedAt).getUTCFullYear();
const firstYear = 2017;
const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const years = Array.from({ length: currentYear - firstYear + 1 }, (_, i) => firstYear + i);
const counts = new Map(data.days.map(d => [d.date, d]));
const totals = years.map(year => data.days.filter(d => d.date.startsWith(String(year))).reduce((n,d) => n + d.count, 0));
const maximum = Math.max(...totals, 1);
const displayedTotal = totals.reduce((sum, count) => sum + count, 0);
const dateFormat = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const connected = data.sources.filter(s => s.status === 'connected').length;
const bitbucketConnected = data.sources.filter(s => s.provider === 'bitbucket' && s.status === 'connected').length;
function daysFor(year: number) {
  const first = new Date(Date.UTC(year, 0, 1));
  const end = new Date(Date.UTC(year + 1, 0, 1));
  const length = Math.round((+end - +first) / 86400000);
  return Array.from({ length: length + first.getUTCDay() }, (_, i) => {
    if (i < first.getUTCDay()) return null;
    const date = new Date(+first + (i - first.getUTCDay()) * 86400000).toISOString().slice(0,10);
    const count = counts.get(date)?.count || 0;
    const repositories = counts.get(date)?.repositories || 0;
    const future = date > data.generatedAt.slice(0,10);
    const label = `${dateFormat.format(new Date(date))}: ${future ? 'Future date' : `${format.format(count)} ${count === 1 ? 'commit' : 'commits'} across ${repositories} ${repositories === 1 ? 'repository' : 'repositories'}`}.`;
    return { date, count, repositories, label, future, column: Math.floor(i / 7) % 14 + 1, row: Math.floor(i / 98) * 8 + i % 7 + 2, first: i === first.getUTCDay(), level: count === 0 ? 0 : count < 4 ? 1 : count < 10 ? 2 : count < 20 ? 3 : 4 };
  });
}
function bandMonths(year: number, band: number) {
  return [...new Set(daysFor(year).slice(band * 98, (band + 1) * 98).flatMap(day => day ? [months[Number(day.date.slice(5, 7)) - 1]] : []))];
}
const calendarByYear = new Map(years.map(year => [year, daysFor(year)]));
---
<section id="contributions" class="contributions section-pad">
  <div class="shell section-head"><p class="eyebrow">01 / Commits</p><div><h2>Commit history<br /><span>since {firstYear}.</span></h2><p>Pulled from my personal and work accounts<br />on GitHub and Bitbucket.</p></div></div>
  <div class="shell">
    <div class="contribution-stats"><div><strong>{format.format(displayedTotal)}</strong><span>Unique commits since {firstYear}</span></div><div><strong>{yearsOfExperience()}<span> years</span></strong><span>Professional experience</span></div><div><strong>{connected}<span> / 5</span></strong><span>Source accounts connected</span></div><a class="text-link" href="https://github.com/Operatorr" target="_blank" rel="noopener noreferrer">View GitHub <Icon name="solar:arrow-right-up-linear" /></a></div>
    <div class="history-chart" aria-label="Imported commits by year">
      {years.map((year, i) => <button type="button" class:list={['year-bar', { selected:year === currentYear }]} data-year={year} aria-pressed={year === currentYear} aria-controls={`calendar-${year}`} aria-label={`${year}: ${format.format(totals[i])} imported commits. Show daily history.`}><span class="bar-count">{totals[i] ? format.format(totals[i]) : '—'}</span><span class="bar-track"><span style={`height:${Math.max(2, totals[i] / maximum * 100)}%`}></span></span><span class="bar-year">{year}</span></button>)}
    </div>
    <p class="chart-instruction">Pick a year to see it day by day <span>{firstYear}—{currentYear}</span></p>
    <div class="calendar-area">
      {years.map((year, i) => <div class="year-panel" id={`calendar-${year}`} data-panel={year} hidden={year !== currentYear}>
        <div class="calendar-heading"><h3>{year} <span>/ Daily activity</span></h3><p>{format.format(totals[i])} imported commits</p></div>
        <div class="calendar-scroll" tabindex="0" role="region" aria-label={`Daily commit heatmap for ${year}.`}>
          <div class="calendar-months" aria-hidden="true">{months.map(m => <span>{m}</span>)}</div>
          <div class="calendar-grid" role="group" aria-label={`${year} daily activity. Use arrow keys to explore dates, or read the table below.`}>
            {[0, 1, 2, 3].map(band => <span class="calendar-quarter-label" style={`--row:${band * 8 + 1}`} aria-hidden="true">{bandMonths(year, band).map(month => <span>{month}</span>)}</span>)}
            {Array.from({ length: 392 }, (_, slot) => {
              const day = calendarByYear.get(year)![slot];
              return !day && <span class="day calendar-padding" style={`--column:${Math.floor(slot / 7) % 14 + 1};--row:${Math.floor(slot / 98) * 8 + slot % 7 + 2}`} aria-hidden="true" />;
            })}
            {calendarByYear.get(year)!.map(day => day
              ? <button type="button" class:list={['day', `level-${day.level}`, { future: day.future }]} style={`--column:${day.column};--row:${day.row}`} tabindex={day.first ? 0 : -1} aria-label={day.label} title={day.label} data-date={day.date} data-commits={day.count} data-repositories={day.repositories} data-future={day.future} />
              : <span class="day empty year-spacer" aria-hidden="true" />)}
          </div>
        </div>
        <div class="calendar-key"><p>{totals[i] ? 'Hover, focus or tap a day for details. Dates shown in UTC.' : 'No commits imported for this year yet.'}</p><span>Less <i class="level-0"></i><i class="level-1"></i><i class="level-2"></i><i class="level-3"></i><i class="level-4"></i> More</span></div>
        <details class="daily-data"><summary>Read daily counts <Icon name="solar:add-linear" /></summary><div class="data-table-scroll" tabindex="0" role="region" aria-label={`Daily count table for ${year}`}><table><caption>Imported activity in {year}</caption><thead><tr><th scope="col">Date (UTC)</th><th scope="col">Commits</th><th scope="col">Repositories</th></tr></thead><tbody>{data.days.filter(d => d.date.startsWith(String(year))).map(d => <tr><th scope="row">{d.date}</th><td>{d.count}</td><td>{d.repositories}</td></tr>)}</tbody></table>{!totals[i] && <p>No imported records yet.</p>}</div></details>
      </div>)}
    </div>
    <div class="history-footer"><p class="source-list"><span class="connected-dot"></span>GitHub × {data.sources.filter(s => s.provider === 'github' && s.status === 'connected').length}<span class:list={[bitbucketConnected === 2 ? 'connected-dot' : 'pending-dot']}></span>{bitbucketConnected === 2 ? 'Bitbucket × 2' : 'Bitbucket history pending'}</p><span>Updated {new Intl.DateTimeFormat('en-GB', { day:'numeric', month:'short', year:'numeric', timeZone:'UTC' }).format(new Date(data.generatedAt))}</span></div>
    <details class="history-method"><summary>What this history includes <Icon name="solar:add-linear" /></summary><p>Commits since 2017 attributed to my accounts and confirmed author emails, from accessible {bitbucketConnected > 0 ? 'GitHub and Bitbucket' : 'GitHub'} repository histories. A commit appears once, even when it exists in several branches, forks or connected providers. Repository counts include each distinct repository containing that day's commits; mirrors and forks count separately. Private work is shown as counts only.</p><p>My professional development experience starts in September 2015. Much of my work from 2015 and 2016 was in repositories that have since been deleted. Many client repositories from 2020, 2021 and 2022 have also been removed, so those years show only part of my work. {!data.complete && 'This archive is still being assembled. '}{bitbucketConnected < 2 && 'Bitbucket history is not fully imported yet. '}Empty days mean no imported record, not necessarily no work. Inaccessible repositories, deleted branches and unlinked author identities may also be missing.{data.failedImports > 0 && ` ${data.failedImports} source imports need another attempt.`}</p></details>
    <p class="sr-only" id="year-announcement" aria-live="polite"></p>
  </div>
  <noscript><style>.year-panel[hidden]{display:block!important;margin-top:2rem}.history-chart,.chart-instruction{display:none}</style></noscript>
</section>
