---
import PhotoGallery from './PhotoGallery.astro';
import FreedivingGallery from './FreedivingGallery.astro';
import { Icon } from 'astro-icon/components';
import { resume } from '../../lib/resume';
const linkedin = resume.basics.profiles[0].url;
// Qualitative visual levels; the written descriptions remain authoritative.
function languageLevel(fluency: string) {
  if (/^(Native|Fluent)/i.test(fluency)) return 100;
  if (/^Conversational/i.test(fluency)) return 65;
  if (/^Basic/i.test(fluency)) return 20;
  if (/^Beginner/i.test(fluency)) return 4;
  return 0;
}
---
<section id="about" class="about section-pad">
  <div class="shell about-intro">
    <p class="eyebrow">05 / Away from the keyboard</p>
    <div class="about-heading"><h2>There's a person<br /><em>behind the commits.</em></h2><p>I climb, teach freediving, and take a camera along.<br />Different ways to pay attention.</p></div>
    <div class="about-notes"><p class="about-lead">Sweden to Bangkok.<br />A few stops in between.</p><p>I've worked across Sweden, Thailand and Singapore. Outside engineering, I'm an AIDA freediving instructor and competition coach. Athletes I've coached have set two national records.</p><a class="text-link" href="https://www.aidainternational.org/InstructorProfile/f3cff254-d8a3-484d-9a17-90257a6b8ca0" target="_blank" rel="noopener noreferrer">AIDA instructor profile <Icon name="solar:arrow-right-up-linear" /></a></div>
  </div>
  <div class="shell about-grid">
    <FreedivingGallery />
    <PhotoGallery variant="detail" label="Climbing photos" caption="Climbing / Above the water" photos={[
      { src: '/images/climbing-river.webp', alt: 'A climber ascending a rock face above turquoise river rapids', width: 720, height: 900, position: '50% 100%' },
      { src: '/images/climbing-summit.webp', alt: 'A climber balancing on a granite summit above the mountains and coast', width: 1080, height: 810, position: '50% 50%' },
    ]} />
  </div>
  <div class="shell background-grid">
    <div><p class="eyebrow">Education</p><h3>Uppsala University</h3><p>Software Engineering · 2012–2014</p><p>Associate of Applied Science</p><details><summary>Earlier studies & certifications <Icon name="solar:add-linear" /></summary><ul>{resume.education.slice(1).map(e => <li>{e.area}<span>{e.institution} · {e.endDate}</span></li>)}{resume.certificates.map(c => <li>{c.name}<span>{c.issuer} · {c.date}</span></li>)}</ul></details></div>
    <div><p class="eyebrow">Languages</p><dl class="languages">{resume.languages.map(l => <div><dt>{l.language}</dt><dd><span class="language-level">{l.fluency}</span><span class="language-meter" data-tone={/^(Native|Fluent)/i.test(l.fluency) ? "fluent" : /^Beginner/i.test(l.fluency) ? "beginner" : undefined} aria-hidden="true"><span style={`width:${languageLevel(l.fluency)}%`}></span></span></dd></div>)}</dl></div>
  </div>
</section>
<section class="contact section-pad" id="contact">
  <div class="shell"><p class="eyebrow">06 / What's next?</p><div class="contact-heading"><h2>Let's build<br /><em>something useful.</em></h2><a class="contact-circle" href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="Contact Alexander on LinkedIn"><Icon name="solar:arrow-right-up-linear" /></a></div><div class="contact-bottom"><p>Have a system to build or a team to grow?<br />Tell me what you're working on.</p><div><a class="text-link" href={linkedin} target="_blank" rel="noopener noreferrer">Message on LinkedIn <Icon name="solar:arrow-right-up-linear" /></a><a class="text-link" href="/cv">View / print résumé <Icon name="solar:download-linear" /></a></div></div></div>
</section>
<footer class="footer shell"><span>© {new Date().getFullYear()} Alexander Widing</span><span>Built using the <a href="https://jsonresume.org/" target="_blank" rel="noopener noreferrer">JSON Resume standard</a></span><a href="#top">Back to top <Icon name="solar:arrow-up-linear" /></a></footer>
