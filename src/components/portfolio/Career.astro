---
import { Icon } from 'astro-icon/components';
import { resume, dateRange } from '../../lib/resume';
import Projects from './Projects.astro';
---
<section id="experience" class="career section-pad">
  <div class="shell section-head"><p class="eyebrow">02 / Experience</p><div><h2>Where I've<br /><span>worked.</span></h2><p>Freelance sites in Stockholm, then internal systems in Singapore and Bangkok.<br class="desktop-only" /> Now architecture and engineering at DxT.</p></div></div>
  <div class="shell career-list">
    {resume.work.map((job, i) => <details class="career-row" open={i === 0}>
      <summary><span class="career-date">{dateRange(job.startDate, job.endDate)}{!job.endDate && <span class="current-label">Current</span>}</span><span class="career-role"><h3>{job.position}</h3><span>{job.name}</span></span><span class="career-toggle" aria-hidden="true"><Icon name="solar:add-linear" /></span></summary>
      <div class="career-detail"><span>{job.location}{job.description && <><br /><br />{job.description}</>}</span><div>{job.summary && <p>{job.summary}</p>}{job.highlights?.length > 0 && <ul>{job.highlights.map(h => <li>{h}</li>)}</ul>}</div></div>
    </details>)}
  </div>
</section>
<Projects />
<section class="expertise section-pad" id="expertise">
  <div class="shell section-head"><p class="eyebrow">04 / Skills</p><div><h2>What I<br /><span>work with.</span></h2><p>Open a category for the full list.</p></div></div>
  <div class="shell skill-list">
    {resume.skills.map((group, i) => <details class="skill-row">
      <summary>
        <span class="skill-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <span class="skill-heading"><h3>{group.name}</h3><span>{group.level} · {group.keywords.length} skills</span></span>
        <span class="skill-preview" aria-hidden="true">{group.keywords.slice(0, 4).join(' · ')}{group.keywords.length > 4 && <span class="skill-more"> +{group.keywords.length - 4}</span>}</span>
        <span class="skill-toggle" aria-hidden="true"><Icon name="solar:add-linear" /></span>
      </summary>
      <ul class="skill-keywords" aria-label={`${group.name} skills`}>{group.keywords.map(skill => <li>{skill}</li>)}</ul>
    </details>)}
  </div>
</section>
