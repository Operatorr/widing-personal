---
const ticks = [0, 20, 40, 60, 80, 100];
---
<aside class="gauge" aria-label="Dive depth" data-gauge>
  <div class="gauge__panel">
    <p class="gauge__label">Depth <span data-gauge-state>Surface</span></p>
    <p class="gauge__read"><span data-gauge-val>0</span><span class="gauge__unit">m</span></p>
    <div class="gauge__description">
      <p class="gauge__title" data-gauge-title>At the surface</p>
      <p class="gauge__range">One breath · 0–100 m</p>
    </div>
    <dl class="gauge__details">
      <div><dt>Pressure</dt><dd><span data-gauge-pressure>1</span> <small>atm</small></dd></div>
      <div class="gauge__pressure-track" aria-hidden="true"><i data-gauge-pressure-fill></i></div>
      <div><dt>Section</dt><dd data-gauge-section>Introduction</dd></div>
    </dl>
    <p class="gauge__note">≈ 1 extra atmosphere every 10 m</p>
  </div>
  <div class="gauge__scale" aria-hidden="true">
    <span class="gauge__spine"></span>
    <span class="gauge__fill" data-gauge-fill></span>
    {ticks.map((t) => (
      <span class="gauge__tick" style={`--t:${t}`}><span class="gauge__num">{t}</span></span>
    ))}
    <span class="gauge__marker" data-gauge-marker></span>
  </div>
</aside>
