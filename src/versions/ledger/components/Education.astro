---
import { Icon } from 'astro-icon/components';
import SectionHead from './SectionHead.astro';
import { resume, formatDate } from '../../../lib/resume';

const { education, certificates } = resume;
---
<section class="sheet" id="education" aria-labelledby="education-title">
  <div class="wrap">
    <SectionHead id="education-title" number="05" title="Education and certificates" total="07" />
    <div class="twocol">
      <div data-reveal>
        <h3 class="col__head">Education</h3>
        <ol class="entries">
          {education.map((e) => (
            <li class="entry">
              <span class="entry__when">{e.startDate === e.endDate ? e.startDate : `${e.startDate} – ${e.endDate}`}</span>
              <div class="entry__body">
                <p class="entry__name">
                  {e.url ? (
                    <a href={e.url} target="_blank" rel="noopener noreferrer">
                      {e.institution} <Icon name="solar:arrow-right-up-linear" aria-hidden="true" />
                    </a>
                  ) : (
                    e.institution
                  )}
                </p>
                <p class="entry__sub">{e.studyType}</p>
                <p class="entry__sub">{e.area}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div data-reveal>
        <h3 class="col__head">Certificates</h3>
        <ol class="entries">
          {certificates.map((c) => (
            <li class="entry">
              <span class="entry__when">{formatDate(c.date)}</span>
              <div class="entry__body">
                <p class="entry__name">
                  {c.url ? (
                    <a href={c.url} target="_blank" rel="noopener noreferrer">
                      {c.name} <Icon name="solar:arrow-right-up-linear" aria-hidden="true" />
                    </a>
                  ) : (
                    c.name
                  )}
                </p>
                <p class="entry__sub">{c.issuer}</p>
                {'highlights' in c && c.highlights?.map((h) => <p class="entry__note">{h}</p>)}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
