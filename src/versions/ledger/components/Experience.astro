---
import SectionHead from './SectionHead.astro';
import { resume, techWork, dateRange, duration, year } from '../../../lib/resume';

const roles = techWork();
const prior = resume.work.find((w) => w.name === 'Prior non-tech experience');

const thisYear = new Date().getFullYear();
const firstYear = Math.min(...roles.map((r) => Number(year(r.startDate))));
const years: number[] = [];
for (let y = thisYear; y >= firstYear; y--) years.push(y);
---
<section class="sheet" id="experience" aria-labelledby="experience-title">
  <div class="wrap">
    <SectionHead id="experience-title" number="02" title="Experience" total="07" />
    <div class="xp">
      <aside class="rail" aria-hidden="true" data-rail>
        <span class="mono">Year index</span>
        <ol class="rail__list">
          <span class="rail__progress" data-rail-progress></span>
          <span class="rail__bracket" data-rail-bracket></span>
          {years.map((y) => (
            <li class="rail__year" data-year={y}>{y}</li>
          ))}
        </ol>
        <p class="rail__caption" data-rail-caption></p>
      </aside>

      <div class="roles" data-roles>
        {roles.map((w) => {
          const start = year(w.startDate);
          const end = w.endDate ? year(w.endDate) : String(thisYear);
          return (
            <article class="role" data-role data-start={start} data-end={end} data-company={w.name}>
              <div class="role__year">{start}{start !== end ? ` – ${w.endDate ? end : 'now'}` : ''}</div>
              <div class="role__meta" data-reveal>
                <p class="role__company">{w.name}</p>
                <p class="role__desc">{w.description}</p>
                <p class="role__desc">{w.location}</p>
                <div class="role__dates">
                  <span class="mono">{dateRange(w.startDate, w.endDate)}</span>
                  <span class="mono">{duration(w.startDate, w.endDate)}</span>
                </div>
              </div>
              <div data-reveal>
                <h3 class="role__title">{w.position}</h3>
                {w.summary && <p class="role__summary">{w.summary}</p>}
                {w.highlights && (
                  <ul class="hl">
                    {w.highlights.map((h) => <li>{h}</li>)}
                  </ul>
                )}
              </div>
            </article>
          );
        })}
        {prior && (
          <p class="xp__prior" data-reveal>
            Before software: {prior.position}, {prior.location}, {dateRange(prior.startDate, prior.endDate)}.
          </p>
        )}
      </div>
    </div>
  </div>
</section>
