---
import { depthColor } from '../depth';
interface Props { id: string; depth: number; from: number; to: number; class?: string }
const { id, depth, from, to, class: cls = '' } = Astro.props;
---

<section
  id={id}
  class={`zone section ${cls}`}
  data-depth={depth}
  aria-labelledby={`${id}-h`}
  style={`--from:${depthColor(from)};--to:${depthColor(to)}`}
>
  <div class="wrap"><slot /></div>
</section>
