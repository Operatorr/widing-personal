---
import { Icon } from 'astro-icon/components';
import { resume, splitName } from '../../../lib/resume';
const { basics } = resume;
const [first, rest] = splitName(basics.name);
const linkedin = basics.profiles.find((p) => p.network === 'LinkedIn')?.url ?? '#';
---

<section id="top" class="hero zone" data-depth="0" aria-labelledby="hero-name">
  <div class="hero-poster" aria-hidden="true"></div>
  <canvas class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <p class="hero-meta">
      <span><Icon name="solar:map-point-linear" aria-hidden="true" />{basics.location.city}</span>
      <span><Icon name="solar:water-linear" aria-hidden="true" />0 m</span>
      <span>{basics.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}</span>
    </p>
    <h1 id="hero-name" class="hero-name" aria-label={basics.name}>
      <span class="line" aria-hidden="true"><span>{first}</span></span>
      <span class="line" aria-hidden="true"><span>{rest}</span></span>
    </h1>
    <p class="hero-label">{basics.label}</p>
    <p class="hero-hook">I design systems and run them in production, from picking the stack to watching the monitors. I also coach freedivers.</p>
    <div class="hero-actions">
      <a class="btn btn-coral" href={linkedin} target="_blank" rel="noopener noreferrer">
        Get in touch
        <Icon name="solar:arrow-right-up-linear" aria-hidden="true" />
      </a>
      <a class="btn btn-ghost" href="/cv">
        <Icon name="solar:printer-linear" aria-hidden="true" />
        Print résumé
      </a>
    </div>
  </div>
  <p class="hero-scroll" aria-hidden="true">Descend <Icon name="solar:arrow-down-linear" /></p>
</section>
