---
import { depthLabel } from '../depth';
interface Props { title: string; depth: number; id: string; lead?: string }
const { title, depth, id, lead } = Astro.props;
const words = title.split(' ');
---

<header class="sec-head">
  <p class="depth-tag">{depthLabel(depth)}</p>
  <h2 id={id} class="split" aria-label={title}>
    {words.map((w) => (<span class="w" aria-hidden="true"><span>{w}</span></span>))}
  </h2>
  {lead && <p class="sec-lead">{lead}</p>}
</header>
