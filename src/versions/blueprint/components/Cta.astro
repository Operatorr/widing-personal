---
import { Icon } from 'astro-icon/components';
import { resume } from '../../../lib/resume';
import SplitHeading from './SplitHeading.astro';

const linkedin = resume.basics.profiles.find((p) => p.network === 'LinkedIn')?.url ?? '#';
const { basics } = resume;
---

<section id="contact" class="cta section crop" aria-labelledby="contact-h">
  <div class="crop-b"></div>
  <div class="wrap cta__grid">
    <div>
      <p class="t-mono" data-reveal style="margin:0 0 1rem">REVISION NOTE &middot; {basics.location.city}</p>
      <SplitHeading text="Start a conversation" class="h2 t-expanded" id="contact-h" />
    </div>
    <div data-reveal>
      <p class="t-serif" style="margin:0 0 1.5rem; max-width: 30rem">
        If you are planning a system, or want an architect who still writes the code, send a message on LinkedIn.
        The print sheet has the same content on one page.
      </p>
      <div class="cta__actions">
        <a class="btn t-label" href={linkedin} rel="me noopener" target="_blank">
          <Icon name="solar:link-linear" width="16" height="16" />
          LinkedIn
        </a>
        <a class="btn btn--ghost t-label" href="/cv">
          <Icon name="solar:printer-linear" width="16" height="16" />
          Print sheet
        </a>
      </div>
    </div>
  </div>
</section>
