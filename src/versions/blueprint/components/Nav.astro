---
import { Icon } from 'astro-icon/components';
interface Props {
  linkedin: string;
}
const { linkedin } = Astro.props;
const links = [
  ['#notes', 'Notes'],
  ['#experience', 'Experience'],
  ['#projects', 'Projects'],
  ['#skills', 'Skills'],
  ['#education', 'Education'],
  ['#contact', 'Contact'],
];
---

<header class="nav" data-nav>
  <div class="wrap nav__row">
    <a href="#top" class="t-label">A. Widing &mdash; Solutions architect</a>

    <nav aria-label="Sections">
      <ul class="nav__links t-label">
        {links.map(([href, label]) => (
          <li><a class="nav__link" href={href}>{label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="nav__right t-label">
      <a class="nav__link" href="/cv">Print sheet &rarr; /cv</a>
      <a class="nav__link" href={linkedin} rel="me noopener" target="_blank">LinkedIn</a>
    </div>

    <button
      class="nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Open menu"
      data-nav-toggle
    >
      <Icon name="solar:hamburger-menu-linear" width="20" height="20" data-icon-open />
      <Icon name="solar:close-circle-linear" width="20" height="20" data-icon-close hidden />
    </button>
  </div>

  <div class="nav__menu wrap" id="nav-menu" data-open="false" data-nav-menu>
    <ul class="t-label">
      {links.map(([href, label]) => (
        <li><a href={href}>{label}</a></li>
      ))}
      <li><a href="/cv">Print sheet &rarr; /cv</a></li>
      <li><a href={linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
    </ul>
  </div>
</header>
