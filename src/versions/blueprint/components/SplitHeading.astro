---
/**
 * A heading whose words are wrapped for a word-by-word reveal.
 * The accessible name stays whole via aria-label; spans are aria-hidden.
 * Without JavaScript the words are simply visible.
 */
interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'h3';
  class?: string;
  id?: string;
}
const { text, as: Tag = 'h2', class: cls = '', id } = Astro.props;
const words = text.split(/\s+/).filter(Boolean);
---

<Tag id={id} class={`split ${cls}`} aria-label={text} data-split>
  {words.map((w, i) => (
    <>
      <span class="w" aria-hidden="true"><span class="wi">{w}</span></span>
      {i < words.length - 1 ? ' ' : ''}
    </>
  ))}
</Tag>
