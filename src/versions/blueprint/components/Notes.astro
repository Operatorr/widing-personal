---
import { resume, yearsOfExperience, techWork } from '../../../lib/resume';
import SectionHead from './SectionHead.astro';

const summary = resume.basics.summary;
const sentences = summary
  .split(/(?<=\.)\s+(?=[A-Z])/)
  .map((s) => s.trim())
  .filter(Boolean);
const years = yearsOfExperience();
const roles = techWork().length;
const projects = resume.projects.length;
---

<section id="notes" class="section" aria-labelledby="notes-h">
  <div class="wrap">
    <SectionHead id="notes-h" ref="NOTE 1" title="General notes" note="read before the drawings" />
    <div class="notes">
      <ol class="notes__list t-serif">
        {sentences.map((s) => (
          <li data-reveal>
            <span class="n" aria-hidden="true"></span>
            <p style="margin:0">{s}</p>
          </li>
        ))}
      </ol>
      <div class="notes__side">
        <div class="stat" data-reveal>
          <span class="big t-expanded">{years}+</span>
          <span class="t-label">years in software</span>
        </div>
        <div class="stat" data-reveal>
          <span class="big t-expanded">{roles}</span>
          <span class="t-label">roles on this sheet</span>
        </div>
        <div class="stat" data-reveal>
          <span class="big t-expanded">{projects}</span>
          <span class="t-label">detailed projects</span>
        </div>
      </div>
    </div>
  </div>
</section>
