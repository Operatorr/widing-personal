---
import { resume, techWork, dateRange, duration, formatDate } from '../../../lib/resume';
import SectionHead from './SectionHead.astro';

const roles = techWork();
const prior = resume.work.find((w) => w.name === 'Prior non-tech experience');
---

<section id="experience" class="exp on-slate" aria-labelledby="experience-h">
  <div class="wrap section" style="padding-bottom:0">
    <SectionHead id="experience-h" ref="SECTION A-A" title="Work history" note={`${roles.length} layers, newest first`} />
  </div>

  <div class="strip" data-strip>
    <div class="strip__track wrap" data-strip-track>
      {roles.map((w, i) => (
        <article class="role" id={`role-${i + 1}`} data-panel>
          <span class="role__id" aria-hidden="true">R-{String(i + 1).padStart(2, '0')}</span>
          <header class="role__head">
            <p class="role__position t-label" style="margin:0">{w.position}</p>
            <h3 class="role__company t-expanded">{w.name}</h3>
            {w.description && <p class="t-mono" style="margin:0; opacity:0.8">{w.description}</p>}
          </header>

          <div class="role__dim dim t-mono" data-dim>
            <span class="dim__t dim__cap">
              &nbsp;{dateRange(w.startDate, w.endDate)} &middot; {duration(w.startDate, w.endDate)}&nbsp;
            </span>
          </div>

          {w.summary && <p class="role__summary t-serif">{w.summary}</p>}

          {w.highlights && (
            <ul class="role__list t-serif">
              {w.highlights.map((h) => <li>{h}</li>)}
            </ul>
          )}

          <footer class="role__foot t-label">
            <span>{w.location}</span>
            <span>{formatDate(w.startDate)} &rarr; {w.endDate ? formatDate(w.endDate) : 'now'}</span>
          </footer>
        </article>
      ))}
    </div>
  </div>

  {prior && (
    <div class="wrap exp__prior t-mono">
      Before software: {prior.position}, {prior.location}, {dateRange(prior.startDate, prior.endDate)}.
    </div>
  )}
</section>
