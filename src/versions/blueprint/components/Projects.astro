---
import { resume, techWork, dateRange } from '../../../lib/resume';
import { slug, roleForProject, roleId, projectId } from '../graph';
import SectionHead from './SectionHead.astro';

const roles = techWork();
const projects = resume.projects;
---

<section id="projects" class="section paper" aria-labelledby="projects-h">
  <div class="wrap">
    <SectionHead id="projects-h" ref="DETAILS" title="Projects" note={`${projects.length} callouts`} />
    <div class="projects">
      {projects.map((p, i) => {
        const owner = roleForProject(p, roles);
        const entity = (p as { entity?: string }).entity;
        return (
          <article class="callout panel" id={`project-${slug(p.name)}`} data-reveal>
            <span class="callout__corner" aria-hidden="true"></span>
            <div class="callout__top t-mono">
              <span>{projectId(i).toUpperCase()}</span>
              <span>{dateRange(p.startDate, (p as { endDate?: string }).endDate, 'ongoing')}</span>
            </div>
            <h3 class="callout__title t-expanded">{p.name}</h3>
            <p class="callout__desc t-serif">{p.description}</p>
            <ul class="callout__list t-serif">
              {p.highlights.map((h) => <li>{h}</li>)}
            </ul>
            <div class="callout__chips">
              {p.keywords.map((k) => <span class="chip t-label">{k}</span>)}
            </div>
            <div class="callout__foot t-label">
              <span>{p.roles.join(' / ')}</span>
              {entity && (
                owner
                  ? <a class="link-ul" href={`#role-${roles.indexOf(owner) + 1}`}>{entity} &middot; {roleId(roles.indexOf(owner)).toUpperCase()}</a>
                  : <span>{entity}</span>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
