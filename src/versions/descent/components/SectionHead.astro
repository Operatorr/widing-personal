---
import SplitWords from './SplitWords.astro';
import { NOTES } from '../depth';

interface Props {
  id: string;
  title: string;
  depth: number;
}
const { id, title, depth } = Astro.props;
const note = NOTES[depth];
---
<div class="sheet__head">
  <div class="depth" aria-hidden="true">
    <span class="depth__m">{depth}<small>m</small></span>
    <span class="depth__line"></span>
    {note && <span class="depth__note">{note}</span>}
  </div>
  <h2 class="sheet__title" id={id} aria-label={title} data-split-head>
    <SplitWords text={title} />
  </h2>
</div>
