---
import '../styles/print.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-zinc-900 antialiased print-layout">
    <slot />
  </body>
</html>

<style is:global>
  body {
    font-family: var(--font-display);
  }
  h1 { font-family: var(--font-display); }
  h2, h3, button, input, .no-print { font-family: var(--font-sans); }

  .print-layout {
    max-width: 210mm;
    margin: 0 auto;
    padding: 0;
  }

  /* Print styles */
  @media print {
    @page {
      size: A4;
      margin: 10mm 12mm;
    }

    html, body {
      width: 210mm;
      font-size: 10pt;
      background: white !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    .print-layout {
      max-width: none;
      padding: 0;
      font-size: 10pt;
      line-height: 1.4;
    }

    .no-print {
      display: none !important;
    }

    .avoid-break {
      break-inside: avoid;
    }

    .break-before {
      break-before: page;
    }
  }

  /* Screen preview styles */
  @media screen {
    body {
      background: #f5f5f5;
      padding: 20px;
    }

    .print-layout {
      background: white;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      padding: 15mm;
    }
  }

  @media screen and (max-width: 640px) {
    body {
      padding: 0;
    }

    .print-layout {
      box-shadow: none;
      padding: 4mm 3mm 140px 3mm;
    }
  }
</style>
