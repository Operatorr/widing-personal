---
import DepthLayout from '../../versions/depth/DepthLayout.astro';
import Hero from '../../versions/depth/components/Hero.astro';
import Summary from '../../versions/depth/components/Summary.astro';
import Experience from '../../versions/depth/components/Experience.astro';
import Projects from '../../versions/depth/components/Projects.astro';
import Skills from '../../versions/depth/components/Skills.astro';
import Education from '../../versions/depth/components/Education.astro';
import Extras from '../../versions/depth/components/Extras.astro';
import Contact from '../../versions/depth/components/Contact.astro';
import Footer from '../../versions/depth/components/Footer.astro';
import { resume } from '../../lib/resume';
const { basics } = resume;
---

<DepthLayout title={`${basics.name} – ${basics.label}`} description={basics.summary}>
  <Hero />
  <Summary />
  <Experience />
  <Projects />
  <Skills />
  <Education />
  <Extras />
  <Contact />
  <Footer />
</DepthLayout>
