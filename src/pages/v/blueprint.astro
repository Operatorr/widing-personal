---
import BlueprintLayout from '../../versions/blueprint/BlueprintLayout.astro';
import Hero from '../../versions/blueprint/components/Hero.astro';
import Notes from '../../versions/blueprint/components/Notes.astro';
import Experience from '../../versions/blueprint/components/Experience.astro';
import Projects from '../../versions/blueprint/components/Projects.astro';
import Skills from '../../versions/blueprint/components/Skills.astro';
import Education from '../../versions/blueprint/components/Education.astro';
import Sidenotes from '../../versions/blueprint/components/Sidenotes.astro';
import Cta from '../../versions/blueprint/components/Cta.astro';
import { resume } from '../../lib/resume';

const { basics } = resume;
---

<BlueprintLayout title={`${basics.name} – ${basics.label}`} description={basics.summary}>
  <Hero />
  <Notes />
  <Experience />
  <Projects />
  <Skills />
  <Education />
  <Sidenotes />
  <Cta />
</BlueprintLayout>
