---
import { resume } from '../lib/resume';

const versions = [
  { slug: 'ledger', name: 'Ledger', line: 'A light editorial broadsheet. The career as a masthead and a pinned year rail.' },
  { slug: 'depth', name: 'Depth', line: 'A dark descent. Scrolling is a freedive, with a depth gauge and a WebGL light-shaft hero.' },
  { slug: 'blueprint', name: 'Blueprint', line: 'A technical drawing. The career as a system diagram on concrete and safety yellow.' },
  { slug: 'descent', name: 'Descent', line: 'Ledger\'s type and layouts in Depth\'s dark water, with the freedive gauge and light-shaft hero.' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{resume.basics.name} – résumé versions</title>
    <style>
      :root { color-scheme: light; }
      body { margin: 0; background: #f4f1ea; color: #141311; font: 16px/1.5 ui-sans-serif, system-ui, sans-serif; }
      main { max-width: 56rem; margin: 0 auto; padding: 4rem 1.5rem; }
      h1 { font-size: 1.25rem; font-weight: 600; margin: 0 0 0.5rem; }
      p.intro { margin: 0 0 2.5rem; color: #5a5751; }
      ol { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
      a.card { display: block; padding: 1.5rem; border: 1px solid #c9c4b8; border-radius: 4px; text-decoration: none; color: inherit; }
      a.card:hover, a.card:focus-visible { border-color: #141311; outline: none; }
      a.card:focus-visible { box-shadow: 0 0 0 3px #d24b1e; }
      a.card span { display: block; }
      .name { font-size: 1.5rem; font-weight: 600; }
      .route { font-family: ui-monospace, monospace; font-size: 0.8rem; color: #5a5751; margin-top: 0.25rem; }
      .line { margin-top: 0.75rem; }
      footer { margin-top: 3rem; font-size: 0.85rem; color: #5a5751; }
    </style>
  </head>
  <body>
    <main>
      <h1>Three candidate redesigns</h1>
      <p class="intro">Pick one to keep. Each is a complete page built from the same résumé data.</p>
      <ol>
        {versions.map((v) => (
          <li>
            <a class="card" href={`/v/${v.slug}`}>
              <span class="name">{v.name}</span>
              <span class="route">/v/{v.slug}</span>
              <span class="line">{v.line}</span>
            </a>
          </li>
        ))}
      </ol>
      <footer>
        The current live page stays at <a href="/">/</a>. Print version at <a href="/cv">/cv</a>.
        See <code>docs/redesign-versions.md</code> for how to promote one.
      </footer>
    </main>
  </body>
</html>
